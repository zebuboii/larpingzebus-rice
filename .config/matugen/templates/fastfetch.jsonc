{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "small"
    },

    "display": {
        "separator": "  ",
        "color": {
            "keys": "{{ colors.primary.default.hex }}",
            "title": "{{ colors.tertiary.default.hex }}",
            "separator": "{{ colors.outline_variant.default.hex }}"
        }
    },

    "modules": [
        "title",
        "os",
        "kernel",
        "wm",
        "shell",
        "cpu",
        "gpu",
        "memory",
        "disk",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}