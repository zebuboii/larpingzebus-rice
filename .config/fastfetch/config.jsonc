{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "small"
    },

    "display": {
        "separator": "  ",
        "color": {
            "keys": "#f3b3e4",
            "title": "#f5b9a5",
            "separator": "#4e444b"
        }
    },

    "modules": [
        "title",
        "os",
        "kernel",
        "wm",
        "shell",
        "cpu",
        "gpu",
        "memory",
        "disk",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}