configuration {
    disable-history: false;
    show-icons: true;
}

* {
    bg: #171216;
    surface: #241e22;
    overlay: #2f282d;
    text: #ecdfe5;
    muted: #d1c2cb;
    sage: #f3b3e4;
    moss: #66355f;

    font: "JetBrains Mono 12";
    background-color: transparent;
    text-color: @text;
}

window {
    width: 750px;
    height: 400px;

    margin: 0px;
    padding: 8px;

    border: 2px;
    border-color: @sage;
    border-radius: 12px;

    background-color: @bg;

    children: [ mainbox ];
}

mainbox {
    margin: 3px;
    padding: 3px;

    spacing: 0px;

    background-color: transparent;

    children: [
        inputbar,
        listview
    ];
}

inputbar {
    margin: 6px 10px 10px 10px;
    padding: 8px 10px;

    border: 1px;
    border-color: @overlay;
    border-radius: 12px;

    background-color: @surface;

    children: [
        prompt,
        entry
    ];
}

prompt {
    padding: 0px;

    background-color: transparent;
    text-color: @muted;
}

entry {
    padding: 0px;

    background-color: transparent;
    text-color: @text;
}

listview {
    margin: 0px;
    padding: 3px;

    spacing: 2px;

    columns: 1;
    flow: vertical;
    fixed-columns: true;

    scrollbar: false;

    background-color: transparent;
}

element {
    margin: 2px 4px;
    padding: 3px;

    border: 0px;
    border-radius: 12px;

    background-color: transparent;
}

element selected {
    border: 1px;
    border-color: @overlay;
    border-radius: 12px;

    background-color: @surface;
}

element-text {
    margin: 4px 8px;
    padding: 0px;

    background-color: transparent;
    text-color: @text;
}

element-text selected {
    text-color: @moss;
}

element-icon {
    size: 32px;
    padding: 2px;

    background-color: transparent;
}